# Copy to .env and fill in. .env is ignored by git; never commit it.
NETBOX_URL=https://<instance>.cloud.netboxapp.com
NETBOX_TOKEN=nbt_<key>.<secret>

# Diode: NetBox > Diode > Client credentials
DIODE_TARGET=grpcs://<instance>.cloud.netboxapp.com/diode
DIODE_CLIENT_ID=
DIODE_CLIENT_SECRET=

# Real Orb agent (4_discover_orb.sh). Device discovery logs in over SSH (NAPALM):
LAB_DEVICE_HOST=
LAB_DEVICE_DRIVER=ios
LAB_DEVICE_USERNAME=
LAB_DEVICE_PASSWORD=
LAB_SITE=NYC-DC1
LAB_LOCATION=Hall A
LAB_ROLE=Access Switch
# Or SNMP discovery: set these and leave LAB_DEVICE_HOST empty
LAB_SNMP_TARGETS=
LAB_SNMP_COMMUNITY=public
